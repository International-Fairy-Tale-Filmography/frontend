@using DataEditor.Core.Services
@using Data.Core.Models
@inherits LayoutComponentBase
@inject GitEntityService ges
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
<MudThemeProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
<MudDialogProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">IFTF Data Editor</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ViewChanges" Disabled="_isCommitting">Commit Changes</MudButton>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu/>
    </MudDrawer>
    <MudMainContent>
        @if (_showOutdatedWarning)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="ma-4">
                <div class="d-flex align-center">
                    <MudText Class="mr-3">@_warningText</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="RefreshFromGitHub" Disabled="_isRefreshingFromGitHub">
                        @(_isRefreshingFromGitHub ? "Refreshing..." : "Refresh from GitHub")
                    </MudButton>
                </div>
            </MudAlert>
        }

        @Body
    </MudMainContent>
</MudLayout>
@code {
    bool _drawerOpen = true;
    bool _isCommitting = false;
    bool _showOutdatedWarning = false;
    bool _isRefreshingFromGitHub = false;
    string _warningText = "A newer Git commit is available. Refresh from GitHub to update local data.";

    protected override async Task OnInitializedAsync()
    {
        await CheckSnapshotFreshness();
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void ViewChanges()
    {
        NavigationManager.NavigateTo("/git-differences");
    }

    private async Task CheckSnapshotFreshness()
    {
        try
        {
            _showOutdatedWarning = await ges.IsLocalSnapshotOutdated();
        }
        catch
        {
            _showOutdatedWarning = false;
        }
    }

    private async Task RefreshFromGitHub()
    {
        _isRefreshingFromGitHub = true;

        try
        {
            await ges.RefreshFromGitHub();
            _showOutdatedWarning = false;
            Snackbar.Add("Local data refreshed from GitHub.", Severity.Success);
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Refresh failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isRefreshingFromGitHub = false;
        }
    }

    [Obsolete("Use ViewChanges instead to navigate to the differences page")]
    private async Task CommitChanges()
    {
        _isCommitting = true;

        var result = await ges.CommitAllChangesToGit();

        Snackbar.Add(result, Severity.Success);
        _isCommitting = false;
    }
}
