@using DataEditor.Core.Services
@using Data.Core.Models
@inherits LayoutComponentBase
@implements IDisposable
@inject GitEntityService ges
@inject GitService GitService
@inject CoreSettingsModel Settings
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
<MudThemeProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
<MudDialogProvider />


<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">IFTF Data Editor</MudText>
        <MudSpacer />
        @if (_branches.Count > 0)
        {
            <MudSelect T="string" Label="Data set" Value="_selectedBranch" ValueChanged="OnBranchChanged" Dense="true" Disabled="_switchingBranch" Style="min-width: 180px;">
                @foreach (var branch in _branches)
                {
                    <MudSelectItem T="string" Value="branch">@branch</MudSelectItem>
                }
            </MudSelect>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ViewChanges" Disabled="_switchingBranch">Review and publish changes</MudButton>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu/>
    </MudDrawer>
    <MudMainContent>
        @if (_isStale)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="ma-4">
                <MudText Typo="Typo.h6">This data set is out of date</MudText>
                <MudText>Someone published newer data while this editing session was open. Your saved changes are still here, but publishing is paused until you review the differences.</MudText>
                <MudButton Color="Color.Inherit" OnClick="CompareData" Class="mt-2">Compare data</MudButton>
                <MudButton Color="Color.Inherit" OnClick="ViewChanges" Class="mt-2 ml-2">Review my changes</MudButton>
            </MudAlert>
        }
        @Body
    </MudMainContent>
</MudLayout>
@code {
    private bool _drawerOpen = true;
    private bool _switchingBranch;
    private bool _isStale;
    private bool _freshnessCheckFailed;
    private readonly CancellationTokenSource _monitorCancellation = new();
    private List<string> _branches = new();
    private string _selectedBranch;

    protected override async Task OnInitializedAsync()
    {
        await GitService.GetConfiguration();
        _branches = await GitService.GetBranches();
        _selectedBranch = Settings.Branch;
        _ = MonitorFreshnessAsync(_monitorCancellation.Token);
    }

    private async Task MonitorFreshnessAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(CheckFreshnessAsync);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task CheckFreshnessAsync()
    {
        var baselineSha = ges.DataVersionSha;
        if (_switchingBranch || _isStale || string.IsNullOrEmpty(baselineSha))
        {
            return;
        }

        var checkedBranch = Settings.Branch;
        string latestSha;
        try
        {
            latestSha = await ges.GetLatestBranchHeadSha();
            _freshnessCheckFailed = false;
        }
        catch (Octokit.ApiException ex)
        {
            if (!_freshnessCheckFailed)
            {
                Snackbar.Add($"Could not check for newer data: {ex.Message}", Severity.Warning);
            }

            _freshnessCheckFailed = true;
            return;
        }
        catch (HttpRequestException ex)
        {
            if (!_freshnessCheckFailed)
            {
                Snackbar.Add($"Could not check for newer data: {ex.Message}", Severity.Warning);
            }

            _freshnessCheckFailed = true;
            return;
        }

        if (checkedBranch == Settings.Branch && baselineSha == ges.DataVersionSha && latestSha != baselineSha)
        {
            _isStale = true;
            StateHasChanged();
            var compareNow = await DialogService.ShowMessageBox(
                "Newer data is available",
                "This data set changed while you were editing. Your saved changes in this tab are preserved, and publishing is paused. Compare the changes before deciding what to re-enter.",
                yesText: "Compare data",
                cancelText: "Keep editing",
                options: new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });

            if (compareNow == true)
            {
                CompareData();
            }
        }
    }

    private void CompareData()
    {
        NavigationManager.NavigateTo("/git-differences?view=latest");
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void ViewChanges()
    {
        NavigationManager.NavigateTo("/git-differences");
    }

    private async Task OnBranchChanged(string branch)
    {
        if (string.IsNullOrWhiteSpace(branch) || branch == Settings.Branch || _switchingBranch)
        {
            return;
        }

        _switchingBranch = true;
        try
        {
            var differences = await ges.GetAllDifferences();
            if (differences.Any(difference => difference.ChangedLinesCount > 0))
            {
                var shouldSwitch = await DialogService.ShowMessageBox(
                    "Switch data set?",
                    "Your saved changes in this editing session will be discarded when you switch. Continue only if you are ready to lose those changes.",
                    yesText: "Switch data set",
                    cancelText: "Keep current data");

                if (shouldSwitch != true)
                {
                    return;
                }
            }

            Settings.Branch = branch;
            await GitService.SaveConfiguration(Settings);
            await ges.ResetCaches();
            _isStale = false;
            _selectedBranch = branch;
            Snackbar.Add($"Now viewing {branch}. Load a data table to begin editing.", Severity.Success);
            NavigationManager.NavigateTo("/home");
        }
        finally
        {
            _switchingBranch = false;
        }
    }

    public void Dispose()
    {
        _monitorCancellation.Cancel();
        _monitorCancellation.Dispose();
    }
}