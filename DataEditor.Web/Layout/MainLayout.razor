@using DataEditor.Core.Services
@using Data.Core.Models
@inherits LayoutComponentBase
@inject GitEntityService ges
@inject GitService GitService
@inject CoreSettingsModel Settings
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
<MudThemeProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
<MudDialogProvider />


<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h5" Class="ml-3">IFTF Data Editor</MudText>
        <MudSpacer />
        @if (_branches.Count > 0)
        {
            <MudSelect T="string" Label="Data set" Value="_selectedBranch" ValueChanged="OnBranchChanged" Dense="true" Disabled="_switchingBranch" Style="min-width: 180px;">
                @foreach (var branch in _branches)
                {
                    <MudSelectItem T="string" Value="branch">@branch</MudSelectItem>
                }
            </MudSelect>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ViewChanges" Disabled="_switchingBranch">Review and publish changes</MudButton>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu/>
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
@code {
    private bool _drawerOpen = true;
    private bool _switchingBranch;
    private List<string> _branches = new();
    private string _selectedBranch;

    protected override async Task OnInitializedAsync()
    {
        await GitService.GetConfiguration();
        _branches = await GitService.GetBranches();
        _selectedBranch = Settings.Branch;
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void ViewChanges()
    {
        NavigationManager.NavigateTo("/git-differences");
    }

    private async Task OnBranchChanged(string branch)
    {
        if (string.IsNullOrWhiteSpace(branch) || branch == Settings.Branch || _switchingBranch)
        {
            return;
        }

        _switchingBranch = true;
        try
        {
            var differences = await ges.GetAllDifferences();
            if (differences.Any(difference => difference.ChangedLinesCount > 0))
            {
                var shouldSwitch = await DialogService.ShowMessageBox(
                    "Switch data set?",
                    "Your saved changes in this editing session will be discarded when you switch. Continue only if you are ready to lose those changes.",
                    yesText: "Switch data set",
                    cancelText: "Keep current data");

                if (shouldSwitch != true)
                {
                    return;
                }
            }

            Settings.Branch = branch;
            await GitService.SaveConfiguration(Settings);
            await ges.ResetCaches();
            _selectedBranch = branch;
            Snackbar.Add($"Now viewing {branch}. Load a data table to begin editing.", Severity.Success);
            NavigationManager.NavigateTo("/home");
        }
        finally
        {
            _switchingBranch = false;
        }
    }
}