@page "/person"

@using Microsoft.EntityFrameworkCore
@using Data.Core.Models
@inject DataEditorDataContext ctx
@inject IDialogService DialogService
@inject GitEntityService ges

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4">People</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Browse and update production people. @Items.Count people</MudText>
    </div>
    <MudButton OnClick="AddItem" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Disabled="@_loading">Add person</MudButton>
</MudStack>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_loadError</MudAlert>
}

<MudTextField @bind-Value="_searchText" Immediate="true" Clearable="true" Placeholder="Search people" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" />

<MudDataGrid T="Person" Items="@Items" QuickFilter="QuickFilter" ReadOnly="true" Virtualize="true" Filterable="true" FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
             Bordered="true" Dense="true" Hover="true" Loading="_loading">
    <NoRecordsContent><MudText Class="pa-4">No people to show. Clear the search or add a person.</MudText></NoRecordsContent>
    <Columns>
        <TemplateColumn Title="Actions" CellClass="text-nowrap">
            <CellTemplate>
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Edit" AriaLabel="@($"Edit {context.Item.FirstName} {context.Item.LastName}")" OnClick="@(() => EditCell(context.Item))">Edit</MudButton>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.FirstName" />
        <PropertyColumn Property="x => x.LastName" />

    </Columns>
    <PagerContent>
        <MudDataGridPager T="Person" />
    </PagerContent>
</MudDataGrid>


@code {
    private bool _loading;
    private string _searchText = string.Empty;
    private string? _loadError;

    public List<Person> Items { get; set; } = new();
    private bool QuickFilter(Person person) => string.IsNullOrWhiteSpace(_searchText) ||
        (person.FirstName?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (person.LastName?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false);

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    private async Task Refresh()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await ges.SeedDataFromGit<Person>();
            Items = await ctx.People.ToListAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load people: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    async Task<EventCallback> EditCell(Person cell)
    {
        await EditItem(cell.Guid);
        return EventCallback.Empty;
    }
    async Task AddItem()
    {
        await EditItem(null);
    }

    async Task EditItem(Guid? id)
    {
        var parameters = new DialogParameters<PersonEdit> { { x => x.Id, id } };
        var title = id is null ? "Add person" : "Edit person";
        var dialog = await DialogService.ShowAsync<PersonEdit>(title, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await Refresh();
        }

    }


}
