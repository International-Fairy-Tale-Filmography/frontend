@page "/"
@inject GitService service
@inject NavigationManager Navigation
<PageTitle>Loading..</PageTitle>

@code {

    protected override async Task OnInitializedAsync()
    {
    // Retrieve the configuration to access the AccessToken
        await service.GetConfiguration();

    // Check if the AccessToken is null or empty
        if (string.IsNullOrWhiteSpace(service._coreSettings.AccessToken))
        {
    // Redirect to the Settings page if AccessToken is missing
            Navigation.NavigateTo("settings");
            return;
        }
        else
        {
            Navigation.NavigateTo("home");
        }
    }
}