@page "/home"
@inject GitService service
@inject NavigationManager Navigation
@using MudBlazor
<PageTitle>Home</PageTitle>

<h1>Hello, @name!</h1>

<MudGrid>

    <MudItem xs="12" sm="6" md="4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="width: 100%; height: 100px;" Href="Film">
            <MudIcon Icon="bi bi-film" />
            <MudText>Films</MudText>
        </MudButton>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="width: 100%; height: 100px;" Href="Country">
            <MudIcon Icon="bi bi-globe" />
            <MudText>Countries</MudText>
        </MudButton>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="width: 100%; height: 100px;" Href="Company">
            <MudIcon Icon="bi bi-building" />
            <MudText>Companies</MudText>
        </MudButton>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="width: 100%; height: 100px;" Href="Language">
            <MudIcon Icon="bi bi-translate" />
            <MudText>Languages</MudText>
        </MudButton>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="width: 100%; height: 100px;" Href="Origin">
            <MudIcon Icon="bi bi-flag" />
            <MudText>Origins</MudText>
        </MudButton>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="width: 100%; height: 100px;" Href="person">
            <MudIcon Icon="bi bi-person" />
            <MudText>People</MudText>
        </MudButton>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="width: 100%; height: 100px;" Href="Role">
            <MudIcon Icon="bi bi-briefcase" />
            <MudText>Roles</MudText>
        </MudButton>
    </MudItem>
</MudGrid>

@code {
    string name;

    protected override async Task OnInitializedAsync()
    {
        // Retrieve the configuration to access the AccessToken
        await service.GetConfiguration();

        // Check if the AccessToken is null or empty
        if (string.IsNullOrWhiteSpace(service._coreSettings.AccessToken))
        {
            // Redirect to the Settings page if AccessToken is missing
            Navigation.NavigateTo("settings");
            return;
        }

        // Proceed to get the user's name if AccessToken is valid
        name = await service.GetUser();
    }
}
