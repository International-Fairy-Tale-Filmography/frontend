@page "/settings"
@inject GitService _service
@inject ISnackbar Snackbar

<PageTitle>Connection setup</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4">Connect to the data service</MudText>
        <MudText Typo="Typo.body1" Class="mt-3">
            This setup is normally completed by the person who manages the data editor. If you were not given a connection token, ask that person to set up access for you.
        </MudText>
        <MudAlert Severity="Severity.Info" Class="mt-4">
            Day-to-day editing does not require you to know about branches or commits. Your connection token is stored in this browser and is used only to access the configured data.
        </MudAlert>

        <MudExpansionPanels Class="mt-4">
            <MudExpansionPanel Text="Advanced setup (administrator only)">
                <MudText Typo="Typo.body2" Class="mb-3">
                    The current app connects directly to GitHub. An administrator can create a token with access to the data repository and enter it here. Do not share the token with other people.
                </MudText>
                <MudTextField T="string" Label="Connection token" InputType="InputType.Password" @bind-Value="_editSettings.AccessToken" />
                <MudList T="string">
                    <MudListItem>
                        <MudText>Open <MudLink Href="https://github.com/settings/tokens" Target="_blank">GitHub token settings</MudLink> and create a token with access to the data repository.</MudText>
                    </MudListItem>
                    <MudListItem>
                        <MudText>Paste the token above and select Connect. The app checks that it can access the data.</MudText>
                    </MudListItem>
                </MudList>
                <MudButton OnClick="Save" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">Connect</MudButton>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudPaper>
</MudContainer>

@code {

    CoreSettingsModel _settings;
    CoreSettingsModel _editSettings = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await _service.GetConfiguration();
        _editSettings.AccessToken = _settings.AccessToken;
        _editSettings.Owner = _settings.Owner;
        _editSettings.RepoName = _settings.RepoName;
        _editSettings.Branch = _settings.Branch;
        _editSettings.Folder = _settings.Folder;

    }

    public async Task Save()
    {
        var validationResult = await _service.ValidateToken(_editSettings.AccessToken);
        if (!validationResult.IsValid)
        {
            Snackbar.Add(validationResult.ErrorMessage, Severity.Error);
            return;
        }

        await _service.SaveConfiguration(_editSettings);
        Snackbar.Add("Connection is ready.", Severity.Success);
    }
    
}
