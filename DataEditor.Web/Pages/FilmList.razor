@page "/film"

@using Microsoft.EntityFrameworkCore
@using Data.Core.Models
@using System.Threading
@inject DataEditorDataContext ctx
@inject IDialogService DialogService
@inject GitEntityService ges
@implements IDisposable

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4">Films</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Browse and update films. @Items.Count films</MudText>
    </div>
    <MudButton OnClick="AddItem" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Disabled="@(_loading || _backgroundLoading)">Add film</MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
    <MudText Typo="Typo.body2" Color="Color.Info">@_loadingStatus</MudText>
}
else if (_backgroundLoading)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="my-2">
        <div class="d-flex align-center">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-3" />
            <MudText>@_loadingStatus</MudText>
            
            @if (_currentFileCount > 0 && _totalFileCount > 0)
            {
                <MudText Class="ml-2">(@_currentFileCount/@_totalFileCount)</MudText>
                <MudProgressLinear Value="@((_currentFileCount * 100) / _totalFileCount)" 
                                  Color="Color.Secondary" Class="ml-4 flex-grow-1" />
            }
        </div>
    </MudAlert>
}

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <MudAlert Severity="Severity.Error" Class="my-2">@_loadError</MudAlert>
}

<MudTextField @bind-Value="_searchText" Immediate="true" Clearable="true" Placeholder="Search films" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" />

<MudDataGrid T="Film" Items="@Items" QuickFilter="QuickFilter" ReadOnly="true" Virtualize="true" Filterable="true" FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
             Bordered="true" Dense="true" Hover="true" Loading="_loading || _backgroundLoading">
    <NoRecordsContent><MudText Class="pa-4">No films to show. Clear the search or add a film.</MudText></NoRecordsContent>
    <Columns>
        <TemplateColumn Title="Actions" CellClass="text-nowrap">
            <CellTemplate>
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Edit" AriaLabel="@($"Edit {context.Item.Title}")" OnClick="@(() => EditCell(context.Item))" Disabled="@_backgroundLoading">Edit</MudButton>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Title" />
        <PropertyColumn Property="x => x.OtherTitle" Required="false" />
        <PropertyColumn Property="x => x.Color" />
        <PropertyColumn Property="x => x.ReleaseYear" />
        <PropertyColumn Property="x => x.Duration" /> 
        <PropertyColumn Property="x => x.Mode" />
        <PropertyColumn Property="x => x.Published" />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Film" />
    </PagerContent>
</MudDataGrid>


@code {
    private bool _loading = true;
    private bool _backgroundLoading = false;
    private string _loadingStatus = "Loading films...";
    private string? _loadError;
    private string _searchText = string.Empty;
    private bool QuickFilter(Film film) => string.IsNullOrWhiteSpace(_searchText) ||
        (film.Title?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (film.OtherTitle?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (film.Color?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (film.Mode?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
        (film.ReleaseYear?.ToString().Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false);
    private CancellationTokenSource _cts = new CancellationTokenSource();
    private int _currentFileCount = 0;
    private int _totalFileCount = 0;

    public List<Film> Items { get; set; } = new();
    
    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
    }
    
    private async Task LoadInitialData()
    {
        _loading = true;
        _loadError = null;
        _loadingStatus = "Loading film data...";
        StateHasChanged();
        
        try
        {
            // Load only Film data initially
            await ges.SeedFilmDataOnly(status =>
            {
                _loadingStatus = status;
                InvokeAsync(StateHasChanged);
            });
            
            // Load films into UI
            Items = await ctx.Films.ToListAsync();
            _loading = false;
            
            // Start loading related data in the background
            await LoadRelatedDataInBackground();
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load films: {ex.Message}";
            _loadingStatus = "Loading films stopped.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
    
    private async Task LoadRelatedDataInBackground()
    {
        _backgroundLoading = true;
        _loadError = null;
        _loadingStatus = "Loading additional data in background...";
        _currentFileCount = 0;
        _totalFileCount = 0;
        StateHasChanged();
        
        try
        {
            await ges.SeedRelatedDataInBackground((status, current, total) =>
            {
                _loadingStatus = status;
                _currentFileCount = current;
                _totalFileCount = total;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load related data: {ex.Message}";
        }
        finally
        {
            _backgroundLoading = false;
            StateHasChanged();
        }
    }

    async Task<EventCallback> EditCell(Film cell)
    {
        if (_loading || _backgroundLoading) return EventCallback.Empty;
        
        await EditItem(cell.Guid);
        return EventCallback.Empty;
    }
    
    async Task AddItem()
    {
        if (_loading || _backgroundLoading) return;
        
        await EditItem(null);
    }

    async Task EditItem(Guid? id)
    {
        var parameters = new DialogParameters<FilmEdit> { { x => x.Id, id } };
        var title = id is null ? "Add film" : "Edit film";
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };
        var dialog = await DialogService.ShowAsync<FilmEdit>(title, parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await Refresh();
        }
    }
    
    async Task Refresh()
    {
        _loading = true;
        _loadError = null;
        _loadingStatus = "Refreshing data...";
        StateHasChanged();
        try
        {
            Items = await ctx.Films.ToListAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Could not refresh films: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
