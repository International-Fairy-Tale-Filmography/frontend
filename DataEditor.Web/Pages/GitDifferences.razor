@page "/git-differences"
@using DataEditor.Core.Services
@using Microsoft.AspNetCore.Components
@using Data.Core.Models
@inject GitEntityService GitEntityService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Review changes</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Elevation="3" Class="pa-4">
        <MudText Typo="Typo.h4">@(ShowingLatestChanges ? "Compare data versions" : "Review your changes")</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">@(ShowingLatestChanges ? "Compare the data that changed on the selected data set with the changes saved in this tab. Your edits have not been discarded." : "Check the changes you have saved in this editing session before publishing them.")</MudText>
        
        <MudDivider Class="my-4" />
        
        @if (IsLoading)
        {
            <MudProgressLinear Indeterminate="true" Class="my-4" />
            <MudText>Calculating differences...</MudText>
        }
        else if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="my-4">@ErrorMessage</MudAlert>
        }
        else if (Differences.Count == 0 && !ShowingLatestChanges)
        {
            <MudAlert Severity="Severity.Info" Class="my-4">There are no saved changes to publish. Your data is up to date.</MudAlert>
        }
        else
        {
            @if (ShowingLatestChanges)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">Publishing is paused because this tab's data is older than the selected data set. Use these comparisons to review changes, then reload the latest data before continuing.</MudAlert>
                <MudButton Variant="Variant.Outlined" OnClick="GoBack" Class="mb-4">Keep editing my saved changes</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ReloadLatestData" Disabled="IsLoading" Class="mb-4 ml-2">Discard my saved changes and load latest data</MudButton>
                @if (DraftDifferences.Count > 0)
                {
                    <MudText Typo="Typo.h5" Class="mt-4">Changes saved in this tab</MudText>
                    @foreach (var diff in DraftDifferences.Where(item => item.ChangedLinesCount > 0))
                    {
                        <MudExpansionPanel Text="@diff.FileName">
                            @foreach (var record in diff.RecordDifferences)
                            {
                                @RenderRecordChange(record)
                            }
                        </MudExpansionPanel>
                    }
                }
                <MudText Typo="Typo.h5" Class="mt-4">Newer data to review</MudText>
                @if (Differences.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Class="my-2">The selected data set has advanced, but there are no differences in the tables currently loaded in this tab.</MudAlert>
                }
            }
            else
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           OnClick="CommitChanges"
                           Disabled="IsCommitting"
                           StartIcon="@Icons.Material.Filled.Save"
                           Class="mb-4">
                   @(IsCommitting ? "Publishing..." : "Publish changes")
                </MudButton>
            }
            
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Secondary" 
                       OnClick="GoBack"
                       Class="mb-4 ml-2">
                Cancel
            </MudButton>
            
            <MudExpansionPanels>
                @foreach (var diff in Differences)
                {
                    <MudExpansionPanel 
                        @key="diff.FileName" 
                        IsInitiallyExpanded="@(diff.ChangedLinesCount > 0)" 
                        Class="@(diff.ChangedLinesCount > 0 ? "mud-border-success" : "")">
                        <TitleContent>
                            <MudText>
                                <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" />
                                @diff.FileName
                                @if (diff.ChangedLinesCount > 0)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="ml-2">@diff.ChangedLinesCount changed records</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Class="ml-2">No changes</MudChip>
                                }
                            </MudText>
                        </TitleContent>
                        <ChildContent>
                            <MudDivider />
                            @if (diff.ChangedLinesCount > 0)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-2">
                                    Records changed in @diff.FileName:
                                </MudText>
                                @foreach (var record in diff.RecordDifferences)
                                {
                                    @RenderRecordChange(record)
                                }
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">
                                    No differences found in this file.
                                </MudText>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    </MudPaper>
</MudContainer>

<div>
    <p>@ProgressMessage</p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string View { get; set; }

    private bool ShowingLatestChanges => View == "latest";
    private bool IsLoading { get; set; } = true;
    private bool IsCommitting { get; set; } = false;
    private string ErrorMessage { get; set; }
    private List<GitEntityService.FileDifference> Differences { get; set; } = new List<GitEntityService.FileDifference>();
    private List<GitEntityService.FileDifference> DraftDifferences { get; set; } = new();
    private string ProgressMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDifferences();
    }

    private async Task LoadDifferences()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            if (ShowingLatestChanges)
            {
                DraftDifferences = await GitEntityService.GetAllDifferences();
                Differences = await GitEntityService.GetLatestVersionDifferences();
            }
            else
            {
                Differences = await GitEntityService.GetAllDifferences();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"We could not load your changes. Please try again. Details: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CommitChanges()
    {
        IsCommitting = true;
        ErrorMessage = null;
        ProgressMessage = "Checking that this data set is up to date...";
        try
        {
            await GitEntityService.CommitAllChangesToGit((message) =>
            {
                InvokeAsync(() =>
                {
                    ProgressMessage = message;
                    StateHasChanged();
                });
            });
            ProgressMessage = "Your changes have been published.";
            Snackbar.Add("Your changes have been published.", Severity.Success);
            NavigationManager.NavigateTo("/");
        }
        catch (GitEntityService.StaleDataException ex)
        {
            ErrorMessage = ex.Message;
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"We could not publish your changes. No success was reported. Details: {ex.Message}";
            Snackbar.Add("We could not publish your changes. Your edits are still in this session.", Severity.Error);
        }
        finally
        {
            IsCommitting = false;
        }
    }

    // Optional: Add a separate method for manually resetting caches if needed
    private async Task ResetCaches()
    {
        ProgressMessage = "Resetting caches...";
        await GitEntityService.ResetCaches();
        ProgressMessage = "Caches reset successfully.";
        Snackbar.Add("All caches have been reset.", Severity.Success);
        await LoadDifferences(); // Refresh differences after cache reset
    }

    private async Task ReloadLatestData()
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Discard this tab's saved changes?",
            "This will permanently remove this tab's saved edits and load the latest data. Use the comparison above to note any changes you need to re-enter.",
            yesText: "Discard edits and load latest data",
            cancelText: "Keep my saved changes");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await GitEntityService.ResetCaches();
            NavigationManager.NavigateTo("/film");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"We could not load the latest data. Your saved changes have not been reported as restored. Details: {ex.Message}";
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }

    private RenderFragment RenderRecordChange(GitEntityService.RecordDifference record) => builder =>
    {
        var sequence = 0;
        builder.OpenComponent<MudPaper>(sequence++);
        builder.AddAttribute(sequence++, "Class", "pa-3 mt-2");
        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(content =>
        {
            var contentSequence = 0;
            content.OpenComponent<MudText>(contentSequence++);
            content.AddAttribute(contentSequence++, "Typo", Typo.subtitle1);
            content.AddAttribute(contentSequence++, "ChildContent", (RenderFragment)(text => text.AddContent(0, $"{record.ChangeType}: {record.RecordLabel}")));
            content.CloseComponent();
            content.OpenComponent<MudSimpleTable>(contentSequence++);
            content.AddAttribute(contentSequence++, "Dense", true);
            content.AddAttribute(contentSequence++, "ChildContent", (RenderFragment)(table =>
            {
                var tableSequence = 0;
                table.OpenElement(tableSequence++, "thead");
                table.OpenElement(tableSequence++, "tr");
                foreach (var heading in new[] { "Field", "Previous value", "New value" })
                {
                    table.OpenElement(tableSequence++, "th");
                    table.AddContent(tableSequence++, heading);
                    table.CloseElement();
                }
                table.CloseElement();
                table.CloseElement();
                table.OpenElement(tableSequence++, "tbody");
                foreach (var field in record.Fields)
                {
                    table.OpenElement(tableSequence++, "tr");
                    table.OpenElement(tableSequence++, "td");
                    table.AddContent(tableSequence++, field.FieldName);
                    table.CloseElement();
                    table.OpenElement(tableSequence++, "td");
                    table.AddContent(tableSequence++, DisplayValue(field.OldValue));
                    table.CloseElement();
                    table.OpenElement(tableSequence++, "td");
                    table.AddContent(tableSequence++, DisplayValue(field.NewValue));
                    table.CloseElement();
                    table.CloseElement();
                }
                table.CloseElement();
            }));
            content.CloseComponent();
        }));
        builder.CloseComponent();
    };

    private static string DisplayValue(string value) => string.IsNullOrEmpty(value) ? "(empty)" : value;

}
