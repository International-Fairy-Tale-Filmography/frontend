@using Microsoft.EntityFrameworkCore
@using DataEditor.Core.Services
@using Data.Core.Models

@inject DataEditorDataContext ctx
@inject GitEntityService ges
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="item.Name" Label="Name"></MudTextField>
        <MudTextField @bind-Value="item.Code" Label="Code"></MudTextField>
        
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.h6">Contribution history</MudText>
        <ContributionListField @bind-Value="item.ContributionHistory" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="Save">Save changes</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Guid? Id { get; set; } = null;

    public Country item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id != null)
        {
            item = await ctx.Countries.AsNoTracking().FirstAsync(i => i.Guid == Id);
        }
        else
        {
            item = new Country();
        }

    }

    private async Task Save()
    {
        if (Id == null)
        {
            
            await ctx.Countries.AddAsync(item);
        }
        else
        {
            var existing = ctx.Countries.Local.FirstOrDefault(country => country.Guid == item.Guid);
            if (existing is null)
            {
                ctx.Countries.Update(item);
            }
            else
            {
                ctx.Entry(existing).CurrentValues.SetValues(item);
            }
        }

        await ctx.SaveChangesAsync();
        ges.RecordSaveClick();

        Snackbar.Add($"{item.Name} saved in this editing session. Publish your changes when ready.", Severity.Success);
        MudDialog.Close();

    }

    private void Cancel() => MudDialog.Cancel();
}
