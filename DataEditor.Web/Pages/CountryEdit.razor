@using Microsoft.EntityFrameworkCore
@using DataEditor.Core.Services
@using Data.Core.Models

@inject DataEditorDataContext ctx
@inject GitEntityService ges
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="item.Name" Label="Name"></MudTextField>
        <MudTextField @bind-Value="item.Code" Label="Code"></MudTextField>
        
        <MudTextField @bind-Value="item.CreatedBy" Label="Created By"></MudTextField>
        <MudDatePicker @bind-Date="item.CreatedOn" Label="Created On" Clearable="true" ShowToolbar="false" />
        <MudTextField @bind-Value="item.UpdatedBy" Label="Updated By"></MudTextField>
        <MudDatePicker @bind-Date="item.UpdatedOn" Label="Updated On" Clearable="true" ShowToolbar="false" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="Save">Save changes</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Guid? Id { get; set; } = null;

    public Country item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id != null)
        {
            item = await ctx.Countries.FirstAsync(i => i.Guid == Id);
        }
        else
        {
            item = new Country();
        }

    }

    private async Task Save()
    {
        if (Id == null)
        {
            
            await ctx.Countries.AddAsync(item);
        }
        else
        {
            ctx.Countries.Update(item);
        }

        await ctx.SaveChangesAsync();
        try
        {
            await ges.SaveDraftAsync(typeof(Country));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Changes are saved in this tab, but the recovery copy could not be updated: {ex.Message}", Severity.Error);
            return;
        }

        Snackbar.Add($"{item.Name} saved in this editing session. Publish your changes when ready.", Severity.Success);
        MudDialog.Close();

    }

    private void Cancel() => MudDialog.Cancel();
}
