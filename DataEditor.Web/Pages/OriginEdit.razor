@using Microsoft.EntityFrameworkCore
@using DataEditor.Core.Services
@using Data.Core.Models
@using Origin = Data.Core.Models.Origin
@inject DataEditorDataContext ctx
@inject GitEntityService ges
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="item.Title" Label="Title"></MudTextField>
        <MudTextField @bind-Value="item.Code" Label="Code"></MudTextField>
        <MudTextField @bind-Value="item.Author" Label="Author"></MudTextField>
        
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.h6">Contribution history</MudText>
        <ContributionListField @bind-Value="item.ContributionHistory" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="Save">Save changes</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Guid? Id { get; set; } = null;

    public Origin item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id != null)
        {
            item = await ctx.Origins.AsNoTracking().FirstAsync(i => i.Guid == Id);
        }
        else
        {
            item = new Origin();
        }

    }

    private async Task Save()
    {
        if (Id == null)
        {
            
            await ctx.Origins.AddAsync(item);
        }
        else
        {
            var existing = ctx.Origins.Local.FirstOrDefault(origin => origin.Guid == item.Guid);
            if (existing is null)
            {
                ctx.Origins.Update(item);
            }
            else
            {
                ctx.Entry(existing).CurrentValues.SetValues(item);
            }
        }

        await ctx.SaveChangesAsync();
        ges.RecordSaveClick();

        Snackbar.Add($"{item.Code} saved in this editing session. Publish your changes when ready.", Severity.Success);
        MudDialog.Close();

    }

    private void Cancel() => MudDialog.Cancel();
}
