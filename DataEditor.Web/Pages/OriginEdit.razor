@using Microsoft.EntityFrameworkCore
@using DataEditor.Core.Services
@using Data.Core.Models
@using Origin = Data.Core.Models.Origin
@inject DataEditorDataContext ctx
@inject GitEntityService ges
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true">Save keeps this origin in the current browser tab. It is not published until you publish your changes. Cancel discards your edits.</MudAlert>
        <MudStack Spacing="3" Class="mt-4">
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Origin details</MudText>
                <MudStack Spacing="2">
                    <MudTextField @bind-Value="item.Title" Label="Title" />
                    <MudTextField @bind-Value="item.Code" Label="Code" />
                    <MudTextField @bind-Value="item.Author" Label="Author" />
                </MudStack>
            </MudPaper>
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6">Contribution history</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Keep a record of who contributed, what they did, and when.</MudText>
                <ContributionListField @bind-Value="item.ContributionHistory" />
            </MudPaper>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" StartIcon="@Icons.Material.Filled.Save">Save origin</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Guid? Id { get; set; } = null;

    public Origin item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id != null)
        {
            item = await ctx.Origins.AsNoTracking().FirstAsync(i => i.Guid == Id);
        }
        else
        {
            item = new Origin();
        }

    }

    private async Task Save()
    {
        if (Id == null)
        {
            
            await ctx.Origins.AddAsync(item);
        }
        else
        {
            var existing = ctx.Origins.Local.FirstOrDefault(origin => origin.Guid == item.Guid);
            if (existing is null)
            {
                ctx.Origins.Update(item);
            }
            else
            {
                ctx.Entry(existing).CurrentValues.SetValues(item);
            }
        }

        await ctx.SaveChangesAsync();
        ges.RecordSaveClick();

        Snackbar.Add($"{item.Code} saved in this editing session. Publish your changes when ready.", Severity.Success);
        MudDialog.Close();

    }

    private void Cancel() => MudDialog.Cancel();
}
