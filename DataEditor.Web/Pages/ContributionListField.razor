@using Data.Core.Models
@inject IDialogService DialogService

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility" OnClick="EditContributions" Disabled="@(!string.IsNullOrEmpty(_error))">View contributions (@_entryCount)</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddContribution" Disabled="@(!string.IsNullOrEmpty(_error))">Add contribution</MudButton>
</MudStack>
@if (!string.IsNullOrEmpty(_error))
{
    <MudText Color="Color.Error" Typo="Typo.caption">@_error</MudText>
}

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    private int _entryCount;
    private string? _error;

    protected override void OnParametersSet()
    {
        try
        {
            _entryCount = ContributionHistoryJson.Deserialize(Value).Count;
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"The contribution list could not be read: {ex.Message}";
        }
    }

    private async Task EditContributions()
    {
        List<ContributionEntry> entries;
        try
        {
            entries = ContributionHistoryJson.Deserialize(Value);
        }
        catch (Exception ex)
        {
            _error = $"The contribution list could not be opened: {ex.Message}";
            return;
        }

        var parameters = new DialogParameters<ContributionListEditor> { { editor => editor.Entries, entries } };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ContributionListEditor>("Contribution history", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: List<ContributionEntry> updatedEntries })
        {
            await UpdateContributions(updatedEntries);
        }
    }

    private async Task AddContribution()
    {
        var dialog = await DialogService.ShowAsync<ContributionEntryEditor>("Add contribution", options: new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ContributionEntry entry })
        {
            List<ContributionEntry> entries;
            try
            {
                entries = ContributionHistoryJson.Deserialize(Value);
            }
            catch (Exception ex)
            {
                _error = $"The contribution list could not be updated: {ex.Message}";
                return;
            }

            entries.Add(entry);
            await UpdateContributions(entries);
        }
    }

    private async Task UpdateContributions(List<ContributionEntry> entries)
    {
        Value = ContributionHistoryJson.Serialize(entries);
        _entryCount = entries.Count;
        _error = null;
        await ValueChanged.InvokeAsync(Value);
    }
}
