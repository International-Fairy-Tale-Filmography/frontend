@using Microsoft.EntityFrameworkCore
@using DataEditor.Core.Services
@using Data.Core.Models
@inject DataEditorDataContext ctx
@inject GitEntityService ges
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true">Save keeps this person in the current browser tab. It is not published until you publish your changes. Cancel discards your edits.</MudAlert>
        <MudStack Spacing="3" Class="mt-4">
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Person details</MudText>
                <MudStack Spacing="2">
                    <MudTextField @bind-Value="item.FirstName" Label="First name" />
                    <MudTextField @bind-Value="item.LastName" Label="Last name" />
                </MudStack>
            </MudPaper>
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.h6">Contribution history</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Keep a record of who contributed, what they did, and when.</MudText>
                <ContributionListField @bind-Value="item.ContributionHistory" />
            </MudPaper>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" StartIcon="@Icons.Material.Filled.Save">@(DeferSave ? "Use this person" : "Save person")</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public Guid? Id { get; set; } = null;

    [Parameter]
    public bool DeferSave { get; set; }

    public Person item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id != null)
        {
            item = await ctx.People.AsNoTracking().FirstAsync(i => i.Guid == Id);
        }
        else
        {
            item = new Person { Guid = Guid.NewGuid() };
        }

    }

    private async Task Save()
    {
        if (DeferSave)
        {
            MudDialog.Close(DialogResult.Ok(item));
            return;
        }

        if (Id == null)
        {
            await ctx.People.AddAsync(item);
        }
        else
        {
            var existing = ctx.People.Local.FirstOrDefault(person => person.Guid == item.Guid);
            if (existing is null)
            {
                ctx.People.Update(item);
            }
            else
            {
                ctx.Entry(existing).CurrentValues.SetValues(item);
            }
        }

        await ctx.SaveChangesAsync();
        ges.RecordSaveClick();

        Snackbar.Add($"{item.FirstName} {item.LastName} saved in this editing session. Publish your changes when ready.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(item));

    }

    private void Cancel() => MudDialog.Cancel();
}
