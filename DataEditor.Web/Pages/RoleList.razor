@page "/role"

@using Microsoft.EntityFrameworkCore
@using Data.Core.Models
@inject DataEditorDataContext ctx
@inject IDialogService DialogService
@inject GitEntityService ges

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h4">Roles</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Browse and update production roles. @Items.Count roles</MudText>
    </div>
    <MudButton OnClick="AddItem" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Disabled="@_loading">Add role</MudButton>
</MudStack>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_loadError</MudAlert>
}

<MudTextField @bind-Value="_searchText" Immediate="true" Clearable="true" Placeholder="Search roles" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" />

<MudDataGrid T="Role" Items="@Items" QuickFilter="QuickFilter" ReadOnly="true" Virtualize="true" Filterable="true" FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
             Bordered="true" Dense="true" Hover="true" Loading="_loading">
    <NoRecordsContent><MudText Class="pa-4">No roles to show. Clear the search or add a role.</MudText></NoRecordsContent>
    <Columns>
        <TemplateColumn Title="Actions" CellClass="text-nowrap">
            <CellTemplate>
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Edit" AriaLabel="@($"Edit {context.Item.Name}")" OnClick="@(() => EditCell(context.Item))">Edit</MudButton>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Name"  />
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Role" />
    </PagerContent>
</MudDataGrid>


@code {
    private bool _loading;
    private string _searchText = string.Empty;
    private string? _loadError;

    public List<Role> Items { get; set; } = new();
    private bool QuickFilter(Role role) => string.IsNullOrWhiteSpace(_searchText) ||
        (role.Name?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false);

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    private async Task Refresh()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await ges.SeedDataFromGit<Role>();
            Items = await ctx.Roles.ToListAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load roles: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    async Task<EventCallback> EditCell(Role cell)
    {
        await EditItem(cell.Guid);
        return EventCallback.Empty;
    }

    async Task AddItem()
    {
        await EditItem(null);
    }

    async Task EditItem(Guid? id)
    {
        var parameters = new DialogParameters<RoleEdit> { { x => x.Id, id } };
        var title = id is null ? "Add role" : "Edit role";
        var dialog = await DialogService.ShowAsync<RoleEdit>(title, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (!result.Canceled)
        {
            await Refresh();
        }

    }

}