@page "/Contribute"

<PageTitle>Contribute</PageTitle>

<h2>Contribute to the Filmography</h2>

<section class="mb-4">
    <h3>Suggest a film or data correction</h3>
    <p>
        Help expand and improve the International Fairy-Tale Filmography by suggesting a film or reporting a correction.
        Use the data repository issue form to provide as much information as possible.
    </p>
    <a href="https://github.com/International-Fairy-Tale-Filmography/data/issues/new/choose" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Submit a film or correction</a>
</section>

<section>
    <h3>Contribute to the website</h3>
    <p>
        Website recommendations, bug reports, and pull requests are welcome through the frontend repository.
    </p>
    <div class="d-flex flex-wrap gap-2">
        <a href="https://github.com/International-Fairy-Tale-Filmography/frontend" class="btn btn-primary" target="_blank" rel="noopener noreferrer">View the frontend repository</a>
        <a href="https://github.com/International-Fairy-Tale-Filmography/frontend/issues/new/choose" class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer">Submit website feedback</a>
    </div>
</section>
