@page "/Film/{slugparam}/{idparam}"

@using Data.Core.Configuration
@using Data.Core.Models
@using FrontEnd.Core.Data
@using FrontEnd.Core.Services
@inject FrontEndDataInitializerService fedis
@inject FrontEndDataContext context

@if (!isLoading)
{
    @if (SelectedFilm != null)
    {
        var directors = GetDirectors(SelectedFilm);
        var countries = SelectedFilm.Countries.Where(i => i.Country != null).Select(i => i.Country).ToList();
        var companies = SelectedFilm.Companies.Where(i => i.Company != null).Select(i => i.Company).ToList();
        var origins = SelectedFilm.Origins.Where(i => i.Origin != null).Select(i => i.Origin).ToList();
        var languages = SelectedFilm.Languages.Where(i => i.Language != null).Select(i => i.Language).ToList();
        var castGroups = GetCastRoleGroups(SelectedFilm);

        <div class="film-detail" id="body">
            <div class="row">
                <div class="col-12">
                    <h2>@SelectedFilm.Title</h2>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="row film-data mb-2">
                        <div class="col-sm-3 col-lg-2">
                            Director(s):
                        </div>
                        <div class="col-sm-9 col-lg-10 film-info">
                            <span class="film-info">
                                @for (var index = 0; index < directors.Count; index++)
                                {
                                    var director = directors[index];
                                    <a href="/Search/ByDirector/@director.Guid">@GetPersonDisplayName(director)</a>
                                    if (index < directors.Count - 1)
                                    {
                                        <text> / </text>
                                    }
                                }
                            </span>
                        </div>
                    </div>

                    <div class="row film-data mb-2">
                        <div class="col-sm-3 col-lg-2">
                            Country(s):
                        </div>
                        <div class="col-sm-9 col-lg-10 film-info">
                            <span class="film-info">
                                @for (var index = 0; index < countries.Count; index++)
                                {
                                    var country = countries[index];
                                    <a href="/Search/ByCountry/@country.Guid">@country.Name</a>
                                    if (index < countries.Count - 1)
                                    {
                                        <text> / </text>
                                    }
                                }
                            </span>
                        </div>
                    </div>

                    <div class="row film-data mb-2">
                        <div class="col-sm-3 col-lg-2">
                            Company(s):
                        </div>
                        <div class="col-sm-9 col-lg-10 film-info">
                            <span class="film-info">
                                @for (var index = 0; index < companies.Count; index++)
                                {
                                    var company = companies[index];
                                    <a href="/Search/ByCompany/@company.Guid">@company.Name</a>
                                    if (index < companies.Count - 1)
                                    {
                                        <text> / </text>
                                    }
                                }
                            </span>
                        </div>
                    </div>

                    <div class="row film-data mb-2">
                        <div class="col-sm-3 col-lg-2">
                            Colour:
                        </div>
                        <div class="col-sm-9 col-lg-10 film-info">
                            <span class="film-info">
                                @SelectedFilm.Color
                            </span>
                        </div>
                    </div>

                    <div class="row film-data mb-2">
                        <div class="col-sm-3 col-lg-2">
                            Mode:
                        </div>
                        <div class="col-sm-9 col-lg-10 film-info">
                            <span class="film-info">
                                @SelectedFilm.Mode
                            </span>
                        </div>
                    </div>

                    <div class="row film-data mb-2">
                        <div class="col-sm-3 col-lg-2">
                            Duration:
                        </div>
                        <div class="col-sm-9 col-lg-10 film-info">
                            <span class="film-info">
                                @SelectedFilm.Duration MIN
                            </span>
                        </div>
                    </div>

                    <div class="row film-data mb-2">
                        <div class="col-sm-3 col-lg-2">
                            Origin(s):
                        </div>
                        <div class="col-sm-9 col-lg-10">
                            <span class="film-info">
                                @for (var index = 0; index < origins.Count; index++)
                                {
                                    var origin = origins[index];
                                    <a href="/Search/ByOrigin/@origin.Guid">@origin.Title</a>
                                    if (index < origins.Count - 1)
                                    {
                                        <text> / </text>
                                    }
                                }
                            </span>
                        </div>
                    </div>

                    <div class="row film-data mb-2">
                        <div class="col-sm-3 col-lg-2">
                            Language(s):
                        </div>
                        <div class="col-sm-9 col-lg-10">
                            <span class="film-info">
                                @for (var index = 0; index < languages.Count; index++)
                                {
                                    var language = languages[index];
                                    <a href="/Search/ByLanguage/@language.Guid">@language.Name</a>
                                    if (index < languages.Count - 1)
                                    {
                                        <text> / </text>
                                    }
                                }
                            </span>
                        </div>
                    </div>

                    <div class="row film-data mb-2">
                        <div class="col-sm-3 col-lg-2">
                            Link(s):
                        </div>
                        <div class="col-sm-9 col-lg-10 film-info">
                            <ul class="link-list unstyled">
                                @foreach (var link in SelectedFilm.Links)
                                {
                                    <li>
                                        <a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Url</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    @if (castGroups.Any())
                    {
                        <div class="cast-container">
                            @foreach (var castGroup in castGroups)
                            {
                                <h5>@castGroup.RoleName</h5>
                                <ul>
                                    @foreach (var person in castGroup.People)
                                    {
                                        <li>
                                            <a href="/Search/ByPerson/@person.Guid">@GetPersonDisplayName(person)</a>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            </div>

            <div id="scrollToTop"></div>
        </div>
    }
    else
    {
        <p>Film Not Found</p>
    }
}

@code {
    [Parameter]
    public string? slugparam { get; set; }

    [Parameter]
    public string? idparam { get; set; }

    private bool isLoading = true;
    public Film? SelectedFilm { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await fedis.FetchData();

        if (Guid.TryParse(idparam, out var guid))
        {
            SelectedFilm = context.Films.FirstOrDefault(i => i.Guid == guid);
        }

        isLoading = false;
    }

    private static List<Person> GetDirectors(Film film)
    {
        return film.PeopleRoles
            .Where(i => i.RoleGuid == CoreSettings.DirectorRoleId && i.Person != null)
            .Select(i => i.Person)
            .GroupBy(i => i.Guid)
            .Select(i => i.First())
            .ToList();
    }

    private static List<(string RoleName, List<Person> People)> GetCastRoleGroups(Film film)
    {
        return film.PeopleRoles
            .Where(i => i.RoleGuid != CoreSettings.DirectorRoleId && i.Role != null && i.Person != null)
            .GroupBy(i => i.Role.Guid)
            .OrderBy(i => i.First().Role.Order)
            .Select(i => (
                RoleName: i.First().Role.Name,
                People: i.Select(x => x.Person)
                    .GroupBy(p => p.Guid)
                    .Select(p => p.First())
                    .ToList()))
            .ToList();
    }

    private static string GetPersonDisplayName(Person person)
    {
        return $"{person.FirstName} {person.LastName}".Trim();
    }
}
