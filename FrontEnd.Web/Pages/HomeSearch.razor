@using Data.Core.Models
@using FrontEnd.Core.Services
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager Navigation
@inject FrontEndDataInitializerService fedis
@inject SearchService SearchService

<div class="d-flex justify-content-end mb-2" style="margin-top:12px">
    <a class="btn btn-primary fw-bold" href="@BuildAppUrl("Export")">
        Export <i class="bi bi-download" aria-hidden="true"></i>
    </a>
</div>

<div class="alert alert-secondary">
    <div class="input-group">
        <button class="btn btn-secondary" type="button" @onclick="SearchFromInput" aria-label="Search"><i class="bi bi-search" aria-hidden="true"></i></button>
        <input type="text" @bind-value="searchTitle" @onkeyup="Enter" class="form-control form-control-lg" placeholder="Search all films by title" aria-label="Search all films by title" />
        <a class="btn btn-secondary d-flex align-items-center" href="@BuildAppUrl("AdvancedSearch")">Advanced</a>
    </div>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Loading films…</span>
    </div>
}
else
{
    <FilmResultsList Films="results" />
}

@code {
    private bool isLoading = true;
    private string searchTitle = string.Empty;
    private List<Film> results = new();

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        await fedis.FetchData();
        await ApplySearchFromUriAsync(Navigation.Uri);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() => ApplySearchFromUriAsync(e.Location));
    }

    private async Task SearchFromInput()
    {
        var destination = string.IsNullOrWhiteSpace(searchTitle)
            ? BuildAppUrl(string.Empty)
            : BuildAppUrl($"?title={Uri.EscapeDataString(searchTitle.Trim())}");

        if (string.Equals(Navigation.Uri, destination, StringComparison.OrdinalIgnoreCase))
        {
            await ApplySearchFromUriAsync(destination);
            return;
        }

        Navigation.NavigateTo(destination);
    }

    private async Task ApplySearchFromUriAsync(string uriString)
    {
        isLoading = true;
        StateHasChanged();

        var uri = Navigation.ToAbsoluteUri(uriString);
        searchTitle = TryGetQueryParamValue(uri.Query, "title") ?? string.Empty;
        results = SearchService.Search(new FilmSearchQuery
        {
            Title = searchTitle,
            Sort = FilmSortOption.TitleAsc,
            Page = 1,
            PageSize = 30
        }).Items.ToList();

        isLoading = false;
        await Task.CompletedTask;
    }

    private async Task Enter(KeyboardEventArgs e)
    {
        if (e.Code is "Enter" or "NumpadEnter")
        {
            await SearchFromInput();
        }
    }

    private string BuildAppUrl(string relativePath)
    {
        return new Uri(new Uri(Navigation.BaseUri), relativePath).AbsoluteUri;
    }

    private static string? TryGetQueryParamValue(string queryString, string key)
    {
        foreach (var pair in queryString.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (!string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return parts.Length == 1 ? string.Empty : Uri.UnescapeDataString(parts[1]);
        }

        return null;
    }
}
