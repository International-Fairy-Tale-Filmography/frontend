@inherits LayoutComponentBase

<div class="site-shell">
    <header class="site-header container">
        <img src="img/banner.png" alt="The International Fairy-Tale Filmography, The University of Winnipeg" class="site-header-image" />

        <nav class="navbar navbar-expand-md site-navigation" aria-label="Main navigation">
            <div class="container-fluid px-0">
                <NavLink class="navbar-brand" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-film" aria-hidden="true"></i> Home
                </NavLink>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-navigation">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><NavLink class="nav-link" href="Home/Welcome">Welcome</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="Home/Faq">FAQ</NavLink></li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item"><NavLink class="nav-link" href="Contribute">Contribute</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="Home/Contact">Contact Us</NavLink></li>
                        <li class="nav-item"><NavLink class="nav-link" href="Home/About">About Filmography</NavLink></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container site-content"><article>@Body</article></main>

    <footer class="container site-footer">
        <p>&copy; @DateTime.Now.Year - Pauline Greenhill, Kendra Magnus-Johnston, Jack Zipes</p>
    </footer>
</div>
